# Contact form (required only for sending contact messages)
WEB3FORMS_ACCESS_KEY=

# ÆVO provider fallback order. Providers without a key are skipped.
# The local bilingual knowledge fallback always runs if every external provider fails.
AEVO_PROVIDER_ORDER=gemini,groq

# Google Gemini
GEMINI_API_KEY=
# Alternative key name supported: GOOGLE_GENERATIVE_AI_API_KEY=
AEVO_GEMINI_MODEL=gemini-3.6-flash

# OpenAI
OPENAI_API_KEY=
AEVO_OPENAI_MODEL=gpt-4.1-mini

# Groq fallback
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AEVO_GROQ_MODEL=openai/gpt-oss-120b

# Optional live GitHub statistics
GITHUB_TOKEN=
